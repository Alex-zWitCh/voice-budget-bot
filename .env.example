BOT_TOKEN=
ALLOWED_CHAT_IDS=
ALLOWED_USER_IDS=
MAX_VOICE_DURATION_SEC=16

GROQ_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3
GROQ_TIMEOUT_SEC=30

# Primary STT: local OpenAI-compatible gateway (stt-gateway), port 7443.
# STT model: faster-whisper-large-v3.
STT_BASE_URL=https://stt.example.com:7443/v1
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-large-v3
STT_TIMEOUT_SEC=120
STT_VERIFY_SSL=false

DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SEC=30
MIN_DEEPSEEK_CONFIDENCE=0.70

REENCODE_VOICE=true
VOICE_SAMPLE_RATE=16000
VOICE_BITRATE=16k
TEMP_AUDIO_DIR=/tmp/voice-budget-bot

DB_TYPE=sqlite
SQLITE_DB_PATH=/data/voice_budget_bot.db

APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
LOG_FILE=/data/logs/voice-budget-bot.log
LOG_MAX_BYTES=2097152
LOG_BACKUP_COUNT=2
PROCESSING_VERSION=1.0
MAX_CONCURRENT_PROCESSING=2

# Welcome message
WELCOME_TITLE=SmartExpense 2.0
WELCOME_INTRO=Отправьте короткое голосовое или текстовое сообщение, чтобы записать доход, расход, напоминание или отложенное списание.
WELCOME_FOOTER=
WELCOME_IMAGE_PATH=assets/readme-description.png
